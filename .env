# ==============================================
# THEA IA 2.0 – VARIABLES DE ENTORNO
# Actualizado: 19 Nov 2025 - H02 FASE 7.2 (Connection Pooling)
# ==============================================


# ==========================================
# 🌍 ENTORNO Y DEBUG
# ==========================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true  # true para desarrollo, false en producción
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL


# ==========================================
# 🚀 API REST (FastAPI)
# ==========================================
API_HOST=0.0.0.0  # 0.0.0.0 para escuchar en todas las interfaces
API_PORT=8000  # Puerto de la API
API_PREFIX=/api/v1  # Prefijo de versión de API
SECRET_KEY=your_super_secret_key_here_change_in_production  # Cambiar en producción


# ==========================================
# 🗄️ BASE DE DATOS POSTGRESQL (H02)
# Driver async: postgresql+asyncpg://
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/thea_ia
DATABASE_HOST=127.0.0.1  # IP local (evita problemas de red)
DATABASE_PORT=5432  # Puerto estándar PostgreSQL
DATABASE_NAME=thea_ia  # Base de datos THEA IA
DATABASE_USER=postgres  # Usuario PostgreSQL
DATABASE_PASSWORD=postgres  # Contraseña (CAMBIAR en producción)


# ==========================================
# 🔗 CONNECTION POOLING (H02 FASE 7.2)
# Configuración avanzada de pool de conexiones
# ==========================================
DB_POOL_SIZE=10  # Conexiones base en pool (development: 5-10, production: 20-50)
DB_MAX_OVERFLOW=20  # Conexiones extra en picos (2x pool_size recomendado)
DB_POOL_TIMEOUT=30  # Segundos esperando conexión disponible
DB_POOL_RECYCLE=3600  # Reciclar conexiones cada 1h (evita stale connections)

# Notas Pool:
# - pool_size: Conexiones permanentes en memoria
# - max_overflow: Conexiones temporales adicionales
# - Total máximo = pool_size + max_overflow (10 + 20 = 30 conexiones)
# - pool_timeout: Si no hay conexión disponible en 30s → error
# - pool_recycle: Renovar conexiones antiguas (evita "server has gone away")


# Pool de conexiones (DEPRECATED - usar DB_* arriba)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30


# ==========================================
# 📦 REDIS (Opcional – Cache H08+)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Vacío si no tiene password en desarrollo
REDIS_DB=0
REDIS_ENABLED=false  # Activar en H08


# ==========================================
# 🤖 BOT TELEGRAM (H02 - Prioridad 1)
# ==========================================
TELEGRAM_BOT_TOKEN=8297680422:AAGhueCQccdmc4vhVUma0lj6mL0p8h1OorI
TELEGRAM_USE_POLLING=true  # true=polling (dev), false=webhook (prod)
TELEGRAM_WEBHOOK_URL=  # URL pública para webhooks (producción)
TELEGRAM_WEBHOOK_SECRET=  # Secret para validar webhooks


# ==========================================
# 🧠 MACHINE LEARNING / NLP (H06)
# ==========================================
SPACY_MODEL=es_core_news_sm  # Modelo español de spaCy
ML_CONFIDENCE_THRESHOLD=0.8  # Umbral de confianza (0.0-1.0)
INTENT_MODEL_PATH=models/intent_classifier.pkl
ENTITY_MODEL_PATH=models/entity_extractor.pkl


# ==========================================
# 📝 LOGGING Y AUDITORÍA
# ==========================================
LOG_FILE_PATH=logs/theaia.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s


# ==========================================
# 📊 MÉTRICAS Y MONITOREO (H12)
# ==========================================
PROMETHEUS_PORT=9090
METRICS_ENABLED=false  # Activar en H12
HEALTH_CHECK_INTERVAL=30


# ==========================================
# 🔗 INTEGRACIONES EXTERNAS (H14)
# ==========================================
# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/google_calendar.json
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar


# Email Notifications
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=notifications@theaia.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=noreply@theaia.com


# ==========================================
# 🔐 SEGURIDAD Y AUTENTICACIÓN (H04)
# ==========================================
JWT_SECRET_KEY=your_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7


# ==========================================
# 🏢 MULTI-TENANT (H02 - Decisión Sesión 5)
# ==========================================
DEFAULT_TENANT_ID=default
TENANT_ISOLATION_ENABLED=true


# ==========================================
# 🧪 TESTING (H07)
# ==========================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/thea_ia_test
TEST_MODE=false


# ==========================================
# 📦 DEPENDENCIAS ESPECÍFICAS HITOS
# ==========================================
# H02: PostgreSQL + Telegram + Connection Pooling ✅
# H03: FSM Avanzado
# H04: Auth + Payments
# H05: 8 Agentes operativos
# H06: ML/NLP mejorado
# H07: Testing completo
# H08+: Redis, Docker, K8s, Monitoring



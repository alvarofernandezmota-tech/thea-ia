# ============================================
# THEA IA - Test Environment Configuration
# H03 Integration Tests - Database Real
# Responsable: Álvaro Fernández Mota
# Fecha: 21 Noviembre 2025
# ============================================

# Database Test Configuration - SYNC DRIVER (psycopg2)
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/theaia_test

# Environment
ENVIRONMENT=test
TESTING=true

# Application
APP_NAME=THEA_IA
APP_VERSION=2.0.0

# Security (solo para tests)
SECRET_KEY=test_secret_key_for_integration_tests_only_not_for_production
JWT_SECRET=test_jwt_secret_for_integration_tests_only_not_for_production
API_KEY=test_api_key_for_integration_tests_only

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed
LOG_TO_FILE=false

# Multi-tenant
ENABLE_MULTI_TENANT=true
DEFAULT_TENANT_ID=test_tenant

# Features
ENABLE_ML_SERVICES=true
ENABLE_ENTITY_EXTRACTION=true
ENABLE_INTENT_DETECTION=true
ENABLE_DATE_PARSING=true
ENABLE_LOCATION_EXTRACTION=true
ENABLE_PERSON_NAME_EXTRACTION=true

# Test Settings
AUTO_CLEANUP=true
RESET_DB_AFTER_TESTS=true
USE_TEST_DATABASE=true

# Performance
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600

